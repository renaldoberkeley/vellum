APP_NAME=Vellum API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://vellum:vellum@localhost:5432/vellum
# Optional fallback when DATABASE_URL is unset:
# SECRET_DB_HOST=localhost
# SECRET_DB_NAME=vellum
# SECRET_DB_USERNAME=postgres
# SECRET_DB_PASSWORD=postgres
# SECRET_DB_PORT=5432
CORS_ORIGINS=http://localhost:3000
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_HISTORY_MESSAGES=16
AI_MAX_OUTPUT_TOKENS=700
